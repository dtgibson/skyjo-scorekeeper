+// MARK: - STORE-SCREENSHOT SCRATCH ONLY (never in the shipped source)
+// Demo state for App Store captures: the May 2026 family. Selected with the
+// DEMO_SCREEN environment variable (setup | board | entry | win); a stand-in
+// vertical fold is added when DEMO_FOLD_X (window x of the fold centre, pt) is set.
+enum Demo {
+    static let env = ProcessInfo.processInfo.environment
+    static var screen: String? { env["DEMO_SCREEN"] }
+    static var foldCenterX: CGFloat? { env["DEMO_FOLD_X"].flatMap(Double.init).map { CGFloat($0) } }
+    static let foldWidth: CGFloat = 24
+    static var suppressOcclusions: Bool { env["DEMO_NO_OCCLUSIONS"] == "1" }
+
+    static let players: [Player] = ["Shawn", "Mike", "David", "Elena", "Phoebe"].enumerated().map { i, n in
+        Player(id: UUID(uuidString: String(format: "00000000-0000-0000-0000-%012d", i + 1))!, name: n)
+    }
+
+    /// raw scores per round in player order, plus who ended the round (index)
+    static let rounds: [([Int], Int)] = [
+        ([5, 12, 7, 8, 10], 2),     // David ended, 7 doubles to 14
+        ([15, 20, 25, 18, 16], 0),
+        ([20, 18, 20, 22, 15], 4),
+        ([10, 22, 18, 16, 20], 0),
+        ([18, 15, 22, 18, 16], 1),
+        ([12, 13, 20, 14, 13], 0),  // Mike reaches 100: Shawn 80, Phoebe 90, Elena 96, Mike 100, David 119
+    ]
+
+    static func session(rounds count: Int) -> GameSession {
+        let built: [Round] = rounds.prefix(count).enumerated().map { n, item in
+            let (raws, ender) = item
+            let minOther = raws.enumerated().filter { $0.offset != ender }.map(\.element).min()
+            let scores = players.enumerated().map { i, p -> RoundScore in
+                let raw = raws[i]
+                let doubled = i == ender && GameSession.isDoubled(raw: raw, minOther: minOther)
+                return RoundScore(playerID: p.id, raw: raw, applied: doubled ? raw * 2 : raw)
+            }
+            return Round(number: n + 1, scores: scores, skyjoPlayerID: players[ender].id)
+        }
+        return GameSession(snapshot: GameSessionSnapshot(players: players, rounds: built))
+    }
+
+    static func route() -> SkyjoScorekeeperApp.Route? {
+        switch screen {
+        case "setup": return .setup(initialPlayers: players)
+        case "board": return .game(session: session(rounds: 1))
+        case "entry": return .game(session: session(rounds: 0))
+        case "win": return .game(session: session(rounds: 6))
+        default: return nil
         }
     }
 }
